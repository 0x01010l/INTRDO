# Environment example for ACS contact API

# Azure Communication Services connection string (copy from the resource 'Keys' blade)
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING="Endpoint=https://<resource>.communication.azure.com/;AccessKey=<your-key>"
ACS_SENDER_EMAIL="no-reply@yourdomain.com"
CONTACT_RECIPIENT_EMAIL="you@yourdomain.com"
# Optional: max submissions per minute
CONTACT_RATE_LIMIT_PER_MIN=10
